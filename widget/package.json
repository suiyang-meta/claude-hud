{
  "name": "claude-hud",
  "version": "3.7.0",
  "description": "Floating desktop widget that shows your Claude.ai usage as blood bars in real time.",
  "main": "main.js",
  "author": {
    "name": "Sui1491",
    "url": "https://github.com/suiyang-meta"
  },
  "license": "MIT",
  "scripts": {
    "prestart": "node sysmon/build.js",
    "start": "electron .",
    "build": "node sysmon/build.js && electron-builder --mac dmg --arm64 --win nsis --x64",
    "build:mac": "node sysmon/build.js && electron-builder --mac dmg --arm64",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.claudehud.app",
    "productName": "HUD for Claude",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "usage/**/*",
      "pet/**/*",
      "notch/**/*",
      "codex/**/*",
      "update/**/*",
      "sysmon/**/*",
      "!sysmon/hud-sysmon",
      "!sysmon/*.c",
      "!sysmon/build.js",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "target": {
        "target": "dmg",
        "arch": "arm64"
      },
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extraResources": [
        {
          "from": "sysmon/hud-sysmon",
          "to": "hud-sysmon"
        }
      ],
      "extendInfo": {
        "NSHumanReadableCopyright": "(c) 2026 Sui1491 — github.com/suiyang-meta/claude-hud — MIT",
        "HUDOriginRepository": "https://github.com/suiyang-meta/claude-hud",
        "HUDAuthor": "Sui1491"
      }
    },
    "win": {
      "icon": "icon.png",
      "target": {
        "target": "nsis",
        "arch": "x64"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HUD for Claude"
    },
    "dmg": {
      "title": "HUD for Claude ${version}",
      "icon": "icon.icns",
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "homepage": "https://github.com/suiyang-meta/claude-hud",
  "repository": {
    "type": "git",
    "url": "https://github.com/suiyang-meta/claude-hud.git"
  }
}
